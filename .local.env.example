# Place a copy of this file in your **Fontaine** repository root as `.local.env`
# (or `fontaine/.local.env`, or set FONTAINE_CONFIG_DIR to a directory that contains it).
# Do not put this in the project you are analyzing; that tree is only `--repo-dir`.
#
# Equivalent long invocation:
#   python -m fontaine --owner owner --repo repo --format human --metrics \
#     --pr-analysis --pr-f2p --repo-dir …/REPO_ROOT --pr-f2p-limit 30
#
# Minimal command (from Fontaine checkout, with GITHUB_TOKEN set):
#   PYTHONPATH=. python -m fontaine --repo-dir …/REPO_ROOT
#
# OWNER/REPO may be omitted if `--repo-dir` points at a clone whose `origin` is github.com.

# FONTAINE_OWNER=owner
# FONTAINE_REPO=repo

FONTAINE_FORMAT=human
FONTAINE_METRICS=1
FONTAINE_PR_ANALYSIS=1
FONTAINE_PR_F2P=1
FONTAINE_PR_F2P_LIMIT=150

# Merged-time window for --pr-analysis (mergedAt).
# Use 0 to disable the limit. Same as CLI --pr-analysis-lookback-days.
FONTAINE_PR_ANALYSIS_LOOKBACK_DAYS=2190
#
# Merged-only GraphQL feed (no open PRs in the listing): same as --pr-analysis-merged-only
# FONTAINE_PR_ANALYSIS_MERGED_ONLY=1

# Same keys without FONTAINE_ prefix:
# OWNER=owner
# REPO=repo
# FORMAT=human
# METRICS=1
# PR_ANALYSIS=1
# PR_F2P=1
# PR_F2P_LIMIT=2
# PR_ANALYSIS_LOOKBACK_DAYS=2190
# PR_ANALYSIS_MERGED_ONLY=1
